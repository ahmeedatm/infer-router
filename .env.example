# .env.example — copier en .env et renseigner les valeurs.
# Docker Compose lit .env automatiquement. Tous ces réglages ont un défaut
# fonctionnel dans app/config.py : ce fichier ne sert qu'à les surcharger.

# ── LLM cibles (OpenRouter) ──────────────────────────────────────────────────
# Requis uniquement pour --provider api. Clé à créer sur
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_S=60.0
# Retry sur erreurs transitoires (timeout, 429, 5xx, corps non-JSON).
# Backoff exponentiel : 2 s, 4 s, 8 s. Les 4xx définitifs ne sont jamais retentés.
OPENROUTER_MAX_RETRIES=3
OPENROUTER_RETRY_BACKOFF_S=2.0

# ── Pool de modèles ──────────────────────────────────────────────────────────
# Le léger n'est pas le meilleur modèle disponible, mais celui dont la qualité
# décroît avec la complexité (0,64 / 0,39 / 0,32). C'est cette faiblesse
# prédictible qui donne au routeur un signal exploitable. Un léger uniformément
# bon (deepseek-v3.2) fait tomber InferRouter sous le tirage aléatoire.
MODEL_LIGHT=qwen/qwen-2.5-72b-instruct
# Le lourd doit creuser un vrai écart : Sonnet était trop proche du léger.
MODEL_HEAVY=anthropic/claude-opus-4.8
# Cap de génération. Généreux pour ne tronquer aucun modèle (le lourd monte à
# ~2700 tokens sur les intents complexes).
RESPONSE_MAX_TOKENS=4096

# ── Profils coût/latence du pool (mesurés sur appels réels) ──────────────────
POOL_LIGHT_COST=0.000168
POOL_LIGHT_LATENCY_MS=11076.0
POOL_HEAVY_COST=0.0285
POOL_HEAVY_LATENCY_MS=15000.0

# ── Planchers de qualité par criticité ───────────────────────────────────────
# Le curseur économie/qualité de l'opérateur. Le routeur prend le modèle le
# moins cher dont la qualité attendue dépasse ce plancher.
QMIN_LOW=0.35
QMIN_MED=0.50
QMIN_HIGH=0.70

# ── Budgets SLA du benchmark (latence ms, coût USD par appel) ────────────────
# Larges par défaut pour que le routeur puisse choisir n'importe quel tier.
BENCH_L_MAX_MS=1e9
BENCH_C_MAX=1e9
BENCH_SEED=42

# ── LLM-Juge local (Ollama) ──────────────────────────────────────────────────
# Depuis un conteneur, viser l'hôte : http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_GENERATION_TIMEOUT_S=600.0
# Ne pas rétrograder vers gemma2:2b : 40 à 50 % d'accord seulement, ce qui
# invalide toute mesure de qualité.
JUDGE_MODEL=gemma2:9b
# Modèle tiers qui génère la checklist RocketEval. Découplé de MODEL_HEAVY par
# neutralité : un modèle du pool ne doit pas produire ses propres critères.
CHECKLIST_MODEL=anthropic/claude-sonnet-4.6
CHECKLIST_MAX_TOKENS=512

# ── Données ──────────────────────────────────────────────────────────────────
INTENTS_SPIKE_PATH=data/intents_spike.yaml
DATASET_PATH=data/intents_dataset.yaml
# Modèle d'embeddings de l'estimateur (variante combinée, hors prototype).
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Modèle fort générateur du dataset d'intents.
GENERATION_MODEL=anthropic/claude-opus-4.8

# ── Divers ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
