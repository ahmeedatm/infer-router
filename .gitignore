# =============================================================================
# InferRouter — .gitignore
# =============================================================================
# COMMITTED (source of truth, never ignore):
#   app/, tests/, scripts/, docs/, docker-compose.yml, Dockerfile,
#   Makefile, requirements.txt, pytest.ini, .env.example, .dockerignore
#
# LOCAL-ONLY (ignored below):
#   .venv/, data/*, __pycache__, IDE config, secrets, large binaries
# =============================================================================

# --- Python runtime ---
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Test / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/

# --- Data (local-only: images, benchmarks, results) ---
data/

# --- Secrets / local config ---
.env
.envrc

# --- Project docs kept local ---
.claude/
CLAUDE.md
TODO.md
REPORT.md
DEMO.md

# --- Large binary / generated files ---
*.pdf
latex/
presentation/
docs/superpowers/

# --- macOS ---
.DS_Store

# --- IDE ---
.idea/
.vscode/
.cursorignore
.cursorindexingignore

# --- Build / packaging ---
build/
dist/
sdist/
wheels/
*.spec
*.manifest
