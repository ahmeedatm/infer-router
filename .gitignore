# =============================================================================
# InferRouter-LLM — .gitignore
# =============================================================================
# VERSIONNÉ (source de vérité) :
#   app/, bench/, experiments/, scripts/, tests/, docs/
#   Dockerfile, docker-compose.yml, .dockerignore, requirements.txt,
#   pytest.ini, .env.example
#   data/*.yaml (jeux d'intents), data/complexity_estimator.joblib (estimateur
#   persisté, déterministe), experiments/results/ (preuves des campagnes)
#
# LOCAL UNIQUEMENT (ignoré ci-dessous) :
#   .venv/, __pycache__, secrets, config IDE, artefacts de build
# =============================================================================

# --- Python runtime ---
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
.eggs/

# --- Environnements virtuels ---
.venv/
venv/
env/

# --- Worktrees git (espaces de travail isolés, jamais versionnés) ---
.worktrees/

# --- Tests / couverture ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/

# --- Données ---
# Tout est ignoré par défaut, sauf les artefacts qui rendent le dépôt
# reproductible depuis un clone frais : les jeux d'intents et l'estimateur
# persisté (RandomForest sur 4 attributs, random_state=42, 1,1 Mo).
data/*
!data/intents_spike.yaml
!data/intents_dataset.yaml
!data/intents_dataset_lengthctrl.yaml
!data/intents_dataset_decorr.yaml
!data/complexity_estimator.joblib

# --- Secrets / config locale ---
.env
.envrc

# --- Docs gardées hors dépôt ---
.claude/
CLAUDE.md
TODO.md
REPORT.md
DEMO.md

# --- Binaires et fichiers générés ---
*.pdf
!docs/InferRouter-LLM.pdf
latex/
presentation/

# --- macOS ---
.DS_Store

# --- IDE ---
.idea/
.vscode/
.cursorignore
.cursorindexingignore

# --- Build / packaging ---
build/
dist/
sdist/
wheels/
*.spec
*.manifest
